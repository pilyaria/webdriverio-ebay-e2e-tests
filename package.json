{
  "name": "webdriverio-hands-on",
  "version": "1.0.0",
  "description": "",
  "main": "test.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "wdio": "wdio run ./wdio.conf.js",
    "test:chai": "wdio run ./wdio.conf.js --spec ./tests/specs/chai.test.js",
    "test:jewelry": "wdio run ./wdio.conf.js --spec ./tests/specs/jewelry.test.js",
    "test:search": "wdio run ./wdio.conf.js --spec ./tests/specs/search.test.js",
    "test:chai:chrome": "cross-env WDIO_BROWSER=chrome wdio run ./wdio.conf.js --spec ./tests/specs/chai.test.js",
    "test:chai:firefox": "cross-env WDIO_BROWSER=firefox wdio run ./wdio.conf.js --spec ./tests/specs/chai.test.js",
    "test:jewelry:chrome": "cross-env WDIO_BROWSER=chrome wdio run ./wdio.conf.js --spec ./tests/specs/jewelry.test.js",
    "test:jewelry:firefox": "cross-env WDIO_BROWSER=firefox wdio run ./wdio.conf.js --spec ./tests/specs/jewelry.test.js",
    "test:search:chrome": "cross-env WDIO_BROWSER=chrome wdio run ./wdio.conf.js --spec ./tests/specs/search.test.js",
    "test:search:firefox": "cross-env WDIO_BROWSER=firefox wdio run ./wdio.conf.js --spec ./tests/specs/search.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@wdio/cli": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/mocha-framework": "^9.29.1",
    "@wdio/spec-reporter": "^9.29.1",
    "allure-commandline": "^2.43.0",
    "cross-env": "^10.1.0",
    "webdriverio": "^9.29.1"
  },
  "dependencies": {
    "@wdio/allure-reporter": "^9.29.1",
    "chai": "^6.2.2"
  }
}
